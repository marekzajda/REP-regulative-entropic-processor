{
  "python_executable": "python",
  "working_directory": ".",
  "allowed_jobs": {
    "inventory": {
      "script": "scripts/inventory.py",
      "max_runtime_seconds": 900
    },
    "regression": {
      "script": "scripts/run_regression.py",
      "max_runtime_seconds": 7200
    },
    "benchmark": {
      "script": "scripts/run_benchmark.py",
      "max_runtime_seconds": 14400
    }
  },
  "environment_allowlist": [
    "CUDA_VISIBLE_DEVICES",
    "OMP_NUM_THREADS"
  ],
  "results_directory": "results",
  "jobs_directory": "jobs/inbox",
  "processed_directory": "jobs/processed",
  "failed_directory": "jobs/failed"
}
